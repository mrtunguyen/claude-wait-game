{
  "name": "claude-wait-game",
  "productName": "Claude Wait Game",
  "version": "1.0.0",
  "description": "A companion window that pops up with fun mini-games while Claude Code is working on your request",
  "main": "src/main.js",
  "author": "mrtunguyen",
  "homepage": "https://github.com/mrtunguyen/claude-wait-game",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrtunguyen/claude-wait-game.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "make-icon": "node scripts/make-icon.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "claude",
    "claude-code",
    "electron",
    "games",
    "snake",
    "trivia"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mrtunguyen.claudewaitgame",
    "productName": "Claude Wait Game",
    "copyright": "Copyright \u00a9 2026 mrtunguyen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mrtunguyen",
        "repo": "claude-wait-game"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "Claude Wait Game",
      "backgroundColor": "#1c1c28"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Wait Game"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "mrtunguyen",
      "synopsis": "Mini-games while Claude Code works"
    }
  }
}
